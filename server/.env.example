NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/triagedesk
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000

# Two DIFFERENT long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Scheduler (the five background jobs). Set to false to run the API without them.
ENABLE_SCHEDULER=true
UPLOAD_DIR=uploads
STALE_WAITING_DAYS=7
AUTO_CLOSE_RESOLVED_DAYS=3
# New tickets skip an agent who already has this many open, while anyone else has room.
MAX_OPEN_TICKETS=15

# Email: SLA warnings, missed SLAs, the daily digest, and "resolved" notes to customers.
# Leave SMTP_URL empty in development: every email is then printed in this terminal instead.
# Gmail example (use an app password, and write @ in the address as %40):
#   SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=TriageDesk <no-reply@triagedesk.local>

# Integration tests run only when this is set. Uncomment it once MongoDB is running.
# Use a SEPARATE database:
# the test suite deletes everything in it before running.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/triagedesk_test
